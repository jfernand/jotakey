(footprint "USB_A_PCB_Edge_2.0mm"
  (version 20240108)
  (generator "konnect")
  (layer "F.Cu")
  (descr "USB 2.0 Series A plug formed by the PCB edge (2.0 mm board, ENIG gold fingers). Contacts per USB 2.0 spec Fig. 6-9: centres +-1.0 and +-3.5 mm; pads 1.5 mm wide; VBUS/GND start 1.0 mm from the edge, D-/D+ 2.0 mm, so power mates first. Origin: board edge, centre line; board extends to +Y. Pin 1 (VBUS) on the left seen from the top with the edge pointing away.")
  (attr smd exclude_from_bom exclude_from_pos_files)
  (tags "USB USB-A PCB edge gold finger")
  (pad "1" smd rect (at -3.5 5) (size 1.5 8) (layers "F.Cu" "F.Mask")  )
  (pad "2" smd rect (at -1 5.5) (size 1.5 7) (layers "F.Cu" "F.Mask")  )
  (pad "3" smd rect (at 1 5.5) (size 1.5 7) (layers "F.Cu" "F.Mask")  )
  (pad "4" smd rect (at 3.5 5) (size 1.5 8) (layers "F.Cu" "F.Mask")  )
